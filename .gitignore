# Dependencies
# No trailing slash: matches node_modules whether it's a real directory or a
# symlink (e.g. a local workaround pointing it outside a cloud-synced folder).
node_modules

# Build output
dist/
dist-ssr/
*.local

# Env
.env
.env.*
!.env.example

# Editor
.vscode/*
!.vscode/extensions.json
.idea

# OS
.DS_Store

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript incremental build info
*.tsbuildinfo
node_modules/.tmp

# Testing
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Husky (installed by `npm run prepare`, do not hand-edit generated hooks)
